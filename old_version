<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ─────────────────────────────────────────────────────────────
   Chrome is strictly ink on paper. Saturated colour is reserved
   for the two things that carry meaning: the operator (identity)
   and the measurement red (your usage). Nothing else is coloured.
   ───────────────────────────────────────────────────────────── */
:root{
  --ink:#0E1E29; --paper:#E7ECEE; --panel:#FFFFFF;
  --rule:#C7D2D7; --rule-soft:#E4EAEC; --muted:#5F7078;
  --measure:#D6412B; --wash:#FFF6E2; --gold:#B0810A;
  --display:'Bricolage Grotesque','Helvetica Neue',Arial,sans-serif;
  --body:'Instrument Sans','Helvetica Neue',Arial,sans-serif;
  --mono:'DM Mono','SFMono-Regular',Consolas,monospace;
  --r:4px; --ease:cubic-bezier(.22,.68,.36,1);
  --shadow:0 1px 2px rgba(14,30,41,.05), 0 18px 40px -28px rgba(14,30,41,.55);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--display);margin:0;font-weight:700;letter-spacing:-.015em}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}
a{color:var(--ink);text-decoration-color:var(--rule);text-underline-offset:3px}
a:hover{text-decoration-color:var(--measure)}
button{font-family:inherit;font-size:inherit;cursor:pointer;color:inherit}
:focus-visible{outline:2px solid var(--measure);outline-offset:2px;border-radius:2px}
.wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.skip{position:absolute;left:-9999px}
.skip:focus{left:24px;top:12px;z-index:200;background:#fff;padding:10px 16px;border-radius:var(--r)}

/* Masthead */
.mast{background:var(--ink);color:#F2F6F7;padding:34px 0 30px;position:relative;overflow:hidden}
.mast::after{content:'';position:absolute;right:-30px;bottom:-26px;width:300px;height:150px;opacity:.06;
  background:
    linear-gradient(#fff,#fff) 0 100%/34px 30% no-repeat,
    linear-gradient(#fff,#fff) 46px 100%/34px 50% no-repeat,
    linear-gradient(#fff,#fff) 92px 100%/34px 70% no-repeat,
    linear-gradient(#fff,#fff) 138px 100%/34px 88% no-repeat,
    linear-gradient(#fff,#fff) 184px 100%/34px 100% no-repeat}
.mast .wrap{display:flex;flex-wrap:wrap;gap:26px;align-items:flex-end;justify-content:space-between;position:relative;z-index:1}
.brand{max-width:640px}
.eyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:#7E949E;margin-bottom:13px;display:flex;align-items:center;gap:10px}
.eyebrow::before{content:'';width:26px;height:1px;background:var(--measure);flex:none}
.mast h1{font-size:clamp(30px,5vw,52px);font-weight:800;line-height:.96;color:#fff;letter-spacing:-.03em}
.mast h1 em{font-style:normal;color:#7E949E}
.tagline{font-size:14.5px;color:#A9BAC2;margin:15px 0 0;max-width:54ch}
.mast-side{display:flex;flex-direction:column;align-items:flex-start;gap:15px}
.stamp{font-family:var(--mono);font-size:11px;line-height:1.8;color:#7E949E;border-left:2px solid var(--measure);padding-left:13px}
.stamp b{color:#F2F6F7;font-weight:500}
.langtog{display:flex;border:1px solid #2C4453;border-radius:100px;overflow:hidden}
.langtog button{background:transparent;border:0;color:#7E949E;padding:5px 15px;font-size:11px;font-family:var(--mono);letter-spacing:.08em;transition:background .15s var(--ease)}
.langtog button[aria-pressed="true"]{background:#F2F6F7;color:var(--ink);font-weight:500}

/* Disclosure */
.caveat{background:var(--wash);border-bottom:1px solid #EBDCB8;font-size:13px;padding:12px 0;color:#6B5518}
.caveat .wrap{display:flex;gap:11px;align-items:flex-start}
.caveat svg{flex:none;margin-top:3px}
.caveat p{margin:0;max-width:108ch}

/* Sizer */
.sizer{background:var(--panel);border-bottom:1px solid var(--rule);padding:32px 0 30px}
.sizer h2{font-size:19px;margin-bottom:6px}
.sizer .lede{color:var(--muted);font-size:13.5px;margin:0 0 24px;max-width:74ch}
.sizer-grid{display:grid;grid-template-columns:minmax(300px,1.5fr) 1fr 1fr;gap:36px;align-items:start}
.lbl{display:block;font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);margin-bottom:11px}
.readout{font-family:var(--display);font-size:34px;font-weight:700;line-height:1;margin-bottom:12px;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.readout .unit{font-size:13px;color:var(--muted);font-weight:500;margin-left:5px;letter-spacing:0}
input[type=range]{width:100%;accent-color:var(--measure);height:24px;cursor:grab}
input[type=range]:active{cursor:grabbing}
.ticks{display:flex;justify-content:space-between;font-family:var(--mono);font-size:9.5px;color:var(--muted);letter-spacing:.05em}
.seg{display:flex;border:1px solid var(--rule);border-radius:var(--r);overflow:hidden}
.seg button{flex:1;background:var(--panel);border:0;border-right:1px solid var(--rule);padding:11px 8px;font-size:12.5px;color:var(--muted);transition:background .15s var(--ease),color .15s var(--ease)}
.seg button:last-child{border-right:0}
.seg button:hover{background:#F4F7F8}
.seg button[aria-pressed="true"]{background:var(--ink);color:#fff;font-weight:600}

/* Toolbar */
.toolbar{position:sticky;top:0;z-index:40;background:rgba(231,236,238,.93);backdrop-filter:blur(10px);border-bottom:1px solid var(--rule);padding:13px 0}
.toolbar .wrap{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--rule);background:var(--panel);border-radius:100px;padding:6px 13px;font-size:12.5px;color:var(--muted);display:inline-flex;align-items:center;gap:7px;transition:border-color .15s var(--ease),background .15s var(--ease),color .15s var(--ease)}
.chip:hover{border-color:var(--muted)}
.chip[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}
.dot{width:8px;height:8px;border-radius:50%;flex:none;box-shadow:0 0 0 1px rgba(0,0,0,.07)}
.divider{width:1px;height:20px;background:var(--rule);margin:0 4px}
.spacer{flex:1}
.selwrap{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--muted)}
select{font-family:var(--body);font-size:13px;padding:7px 10px;border:1px solid var(--rule);border-radius:var(--r);background:var(--panel);color:var(--ink)}
.count{font-family:var(--mono);font-size:11.5px;color:var(--muted);letter-spacing:.03em}
.count b{color:var(--ink);font-weight:500}

/* Chart */
main{padding:26px 0 150px}
.chart{background:var(--panel);border:1px solid var(--rule);border-radius:var(--r);position:relative;overflow:hidden}
.axis{display:grid;grid-template-columns:252px 1fr 158px;align-items:center;border-bottom:1px solid var(--rule);height:34px;font-family:var(--mono);font-size:9.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);position:relative;z-index:6;background:var(--panel)}
.axis-label{padding-left:18px}
.axis-scale{position:relative;height:100%}
.tick{position:absolute;top:0;bottom:0;display:flex;align-items:center;transform:translateX(-50%)}
.tick span{background:var(--panel);padding:0 5px}
.axis-right{text-align:right;padding-right:18px}

.overlay{position:absolute;top:34px;bottom:0;width:0;pointer-events:none;z-index:3}
.gline{position:absolute;top:0;bottom:0;width:1px;background:var(--rule-soft)}
.needle{position:absolute;top:0;bottom:0;width:1px;background:var(--measure);transition:left .3s var(--ease)}
.needle .ntag{position:absolute;top:7px;left:7px;font-family:var(--mono);font-size:9px;letter-spacing:.09em;text-transform:uppercase;color:#fff;background:var(--measure);padding:2px 7px;border-radius:2px;white-space:nowrap}
.needle.flip .ntag{left:auto;right:7px}

.rows{position:relative;z-index:1}
.plan{display:grid;align-items:center;gap:18px;padding:15px 18px;border-bottom:1px solid var(--rule-soft);position:relative;transition:background .14s var(--ease)}
.plan:last-child{border-bottom:0}
.plan:hover{background:rgba(247,250,251,.75)}
.plan.picked{background:var(--wash)}
.plan.picked::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--gold)}
.pickbox{display:flex;align-items:center;justify-content:center}
.pickbox input{width:16px;height:16px;accent-color:var(--ink);cursor:pointer}

.ident .op{display:flex;align-items:center;gap:7px;margin-bottom:4px}
.swatch{width:9px;height:9px;border-radius:2px;flex:none;box-shadow:0 0 0 1px rgba(0,0,0,.07)}
.opname{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.ident h3{font-size:15.5px;line-height:1.22;letter-spacing:-.015em}
.ident .el{font-size:11.5px;color:var(--muted);margin-top:3px}
.tag{display:inline-block;font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;background:var(--gold);color:#fff;padding:2px 7px;border-radius:2px;margin-bottom:6px}

/* Bar: solid = what you would use, tint = headroom above it */
.meter{position:relative}
.track{position:relative;height:34px}
.fill-head,.fill-core{position:absolute;left:0;top:0;bottom:0;border-radius:2px;transition:width .5s var(--ease)}
.fill-head{opacity:.22}
.fill-head.unl{background-image:repeating-linear-gradient(115deg,transparent 0 6px,rgba(255,255,255,.75) 6px 12px)}
.plan.mounting .fill-head,.plan.mounting .fill-core{width:0!important}
.meterlabel{position:absolute;top:50%;transform:translateY(-50%);font-family:var(--mono);font-size:12px;font-weight:500;white-space:nowrap;z-index:3;transition:left .5s var(--ease)}
.meterlabel.inside{color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.35)}
.meterlabel.outside{color:var(--ink)}
.needle-local{display:none;position:absolute;top:-3px;bottom:-3px;width:1px;background:var(--measure);z-index:4}
.subline{display:flex;gap:15px;flex-wrap:wrap;margin-top:8px;font-size:11.5px;color:var(--muted);align-items:center}
.subline b{color:var(--ink);font-weight:600;font-family:var(--mono);font-size:11.5px}
.onnet{background:#EEF3F5;border-radius:2px;padding:2px 7px;font-size:10.5px}
.spare{font-family:var(--mono);font-size:10.5px;color:var(--muted)}
.detailbtn{background:none;border:0;font-size:11.5px;padding:3px 0;color:var(--muted);text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--rule)}
.detailbtn:hover{color:var(--ink)}

.price{text-align:right}
.price .big{font-family:var(--display);font-size:27px;font-weight:700;line-height:1;letter-spacing:-.035em;font-variant-numeric:tabular-nums}
.price .per{font-size:11px;color:var(--muted);margin-left:3px;font-weight:400;letter-spacing:0}
.price .pergb{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-top:6px}
.est{display:inline-block;margin-top:7px;font-family:var(--mono);font-size:9px;letter-spacing:.09em;text-transform:uppercase;padding:2px 7px;border-radius:2px}
.est.confirmed{background:#E8F0EA;color:#2C5A3D}
.est.estimate{background:#FBEBDA;color:#96461F}

.detail{grid-column:1/-1;margin-top:14px;padding:14px 16px;background:#F5F8F9;border-radius:var(--r);font-size:13px}
.detail .prov{font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:.05em;text-transform:uppercase;margin-bottom:9px}
.detail ul{margin:0 0 11px;padding-left:18px;color:var(--muted)}
.detail li{margin-bottom:4px}

.empty{text-align:center;padding:74px 24px}
.empty h3{font-size:20px;margin-bottom:9px}
.empty p{color:var(--muted);max-width:46ch;margin:0 auto;font-size:13.5px}

/* Tray + modal */
.tray{position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--ink);color:#F2F6F7;transform:translateY(110%);transition:transform .28s var(--ease);box-shadow:0 -14px 40px -22px rgba(14,30,41,.7)}
.tray.on{transform:none}
.tray .wrap{display:flex;align-items:center;gap:16px;padding:14px 24px;flex-wrap:wrap}
.tray .n{font-family:var(--display);font-size:22px;font-weight:700}
.tray .names{font-size:12.5px;color:#A9BAC2;flex:1;min-width:180px}
.btn{background:#F2F6F7;color:var(--ink);border:0;border-radius:100px;padding:10px 20px;font-weight:600;font-size:13px;transition:transform .15s var(--ease)}
.btn:hover{transform:translateY(-1px)}
.btn.ghost{background:transparent;color:#A9BAC2;border:1px solid #2C4453}
.btn.line{background:transparent;color:var(--ink);border:1px solid var(--rule)}
.modal{position:fixed;inset:0;z-index:80;background:rgba(14,30,41,.6);display:none;padding:28px;overflow:auto}
.modal.on{display:block}
.sheet{background:var(--panel);max-width:1020px;margin:0 auto;border-radius:var(--r);padding:28px;box-shadow:var(--shadow)}
.sheet header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:20px}
.sheet h2{font-size:23px}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th,td{text-align:left;padding:11px 13px;border-bottom:1px solid var(--rule-soft);vertical-align:top}
thead th{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);border-bottom:1px solid var(--rule)}
tbody th{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:400;width:158px}
td.best{background:var(--wash);font-weight:600}

/* About */
.about{background:var(--panel);border-top:1px solid var(--rule);padding:46px 0}
.about h2{font-size:20px;margin-bottom:24px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:34px}
.about h3{font-size:10.5px;font-family:var(--mono);text-transform:uppercase;letter-spacing:.11em;margin-bottom:10px}
.about p,.about li{font-size:13px;color:var(--muted);line-height:1.6}
.about p{margin:0 0 11px}
.about ul{margin:0;padding-left:17px}
.about li{margin-bottom:6px}
footer{padding:28px 0 70px;font-size:12.5px;color:var(--muted)}
footer p{margin:0 0 9px;max-width:84ch}

@media (max-width:900px){
  .sizer-grid{grid-template-columns:1fr;gap:26px}
  .axis,.overlay{display:none}
  .plan{grid-template-columns:22px 1fr!important;gap:12px;padding:16px}
  .meter,.price{grid-column:1/-1}
  .price{text-align:left;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
  .price .pergb,.est{margin-top:0}
  .needle-local{display:block}
  .mast .wrap{align-items:flex-start}
  .mast-side{flex-direction:row;align-items:center;gap:18px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}html{scroll-behavior:auto}}
@media print{.toolbar,.tray,.sizer,.langtog,.pickbox,.detailbtn,.overlay{display:none!important}body{background:#fff}.plan{break-inside:avoid}}
</style>
</head>
<body>
<a class="skip" href="#chart">Skip to the plans</a>

<header class="mast">
  <div class="wrap">
    <div class="brand">
      <div class="eyebrow" id="eyebrow"></div>
      <h1 id="wordmark"></h1>
      <p class="tagline" id="tagline"></p>
    </div>
    <div class="mast-side">
      <div class="langtog" role="group" aria-label="Language">
        <button data-lang="en" aria-pressed="true">EN</button>
        <button data-lang="el" aria-pressed="false">ΕΛ</button>
      </div>
      <div class="stamp" id="stamp"></div>
    </div>
  </div>
</header>

<div class="caveat">
  <div class="wrap">
    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="#8A6D14" stroke-width="1.4"/><path d="M8 4.5v4.2M8 11.2v.6" stroke="#8A6D14" stroke-width="1.6" stroke-linecap="round"/></svg>
    <p id="caveatText"></p>
  </div>
</div>

<section class="sizer">
  <div class="wrap">
    <h2 id="sizerTitle"></h2>
    <p class="lede" id="sizerLede"></p>
    <div class="sizer-grid">
      <div>
        <label class="lbl" for="useData" id="lblData"></label>
        <div class="readout"><span id="useDataOut">8</span><span class="unit">GB</span></div>
        <input type="range" id="useData" min="0" max="60" step="1" value="8">
        <div class="ticks"><span>0</span><span>15</span><span>30</span><span>45</span><span>60</span></div>
      </div>
      <div>
        <span class="lbl" id="lblCalls"></span>
        <div class="seg" role="group" id="needCalls" aria-labelledby="lblCalls">
          <button data-v="any" aria-pressed="true" id="cAny"></button>
          <button data-v="unlimited" aria-pressed="false" id="cUnl"></button>
        </div>
      </div>
      <div>
        <label class="lbl" for="budget" id="lblBudget"></label>
        <div class="readout">€<span id="budgetOut">40</span></div>
        <input type="range" id="budget" min="2" max="90" step="1" value="40">
        <div class="ticks"><span>€2</span><span>€25</span><span>€46</span><span>€68</span><span>€90</span></div>
      </div>
    </div>
  </div>
</section>

<div class="toolbar">
  <div class="wrap">
    <div class="chips" id="typeChips" role="group" aria-label="Contract type"></div>
    <span class="divider"></span>
    <div class="chips" id="opChips" role="group" aria-label="Operators"></div>
    <div class="spacer"></div>
    <label class="selwrap"><span id="lblSort"></span>
      <select id="sort">
        <option value="price"></option><option value="pergb"></option>
        <option value="data"></option><option value="headroom"></option>
      </select>
    </label>
    <span class="count" id="count"></span>
  </div>
</div>

<main>
  <div class="wrap">
    <div class="chart" id="chart">
      <div class="axis" id="axis">
        <div class="axis-label" id="axisLabel"></div>
        <div class="axis-scale" id="axisScale"></div>
        <div class="axis-right" id="axisRight"></div>
      </div>
      <div class="overlay" id="overlay"></div>
      <div class="rows" id="results"></div>
    </div>
  </div>
</main>

<div class="tray" id="tray">
  <div class="wrap">
    <span class="n" id="trayCount">0</span>
    <span class="names" id="trayNames"></span>
    <button class="btn ghost" id="clearPick"></button>
    <button class="btn" id="openCompare"></button>
  </div>
</div>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="cmpTitle">
  <div class="sheet">
    <header><h2 id="cmpTitle"></h2><button class="btn line" id="closeCompare"></button></header>
    <div style="overflow-x:auto"><table id="cmpTable"></table></div>
  </div>
</div>

<section class="about">
  <div class="wrap">
    <h2 id="aboutTitle"></h2>
    <div class="cols">
      <div><h3 id="hMethod"></h3><p id="pMethod"></p><p id="pScope"></p></div>
      <div><h3 id="hPrices"></h3><p id="pPrices"></p></div>
      <div><h3 id="hCheck"></h3><ul id="checkList"></ul></div>
      <div><h3 id="hSources"></h3>
        <ul>
          <li><a href="https://www.cosmote.gr/static/cosmote/el/programmata-kinitis" target="_blank" rel="noopener">Cosmote Telekom — Gigamax</a></li>
