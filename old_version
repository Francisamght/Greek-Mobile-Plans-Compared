    pPrices:"Οι πάροχοι δεν δημοσιεύουν μία τιμή για κάθε πρόγραμμα συμβολαίου. Η τιμή εξαρτάται από τις γραμμές στο ίδιο ΑΦΜ, τυχόν σταθερή, την επιδότηση συσκευής και την απαλλαγή τέλους. Το Vodafone RED Unlimited έχει ονομαστικό πάγιο 84,91€ αλλά διαφημίζεται από 17€. Όπου δεν υπάρχει μία τεκμηριωμένη τιμή, η δομή του προγράμματος δίνεται ως επιβεβαιωμένη και η τιμή σημειώνεται ως εκτίμηση.",
    hCheck:"Έλεγξε πριν υπογράψεις",
    checkList:["Κάτω των 30; Με εγγραφή στο gov.gr το τέλος κινητής 10% μηδενίζεται.","Ρώτα ποια γίνεται η τιμή μετά την προσφορά, συνήθως τον 13ο ή 25ο μήνα.","Μια δεύτερη γραμμή ή σταθερή συχνά διπλασιάζει τα GB ή μειώνει το πάγιο.","Η φορητότητα αριθμού ολοκληρώνεται σε 1–2 εργάσιμες.","Η περιαγωγή στην ΕΕ χωρίς χρέωση ισχύει έως το 2032, με πολιτική ορθής χρήσης.","Τα δωρεάν bonus GB στην καρτοκινητή μπορεί να αποσυρθούν χωρίς προειδοποίηση."],
    hSources:"Πηγές παρόχων",
    legal:"Ανεξάρτητο και μη εμπορικό. Ο ιστότοπος δεν συνδέεται με κανέναν πάροχο, δεν φέρει διαφήμιση και δεν λαμβάνει προμήθεια. Οι πληροφορίες δίνονται καλόπιστα, αλλά τα τιμολόγια αλλάζουν συχνά — δεσμευτικός είναι μόνο ο τιμοκατάλογος του παρόχου.",
    colophon:"Τιμές σε ευρώ, με ΦΠΑ και τέλος κινητής."
  }
};

/* ── State + helpers ──────────────────────────────────────── */
let lang = "en";
const state = { type:"all", ops:new Set(), sort:"price", useData:8, calls:"any", budget:40, picked:new Set(), open:new Set() };
const t   = k => T[lang][k];
const $   = s => document.querySelector(s);
const eur = n => "€" + n.toFixed(2).replace(/\.00$/,"");
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

const SCALE_MAX = 90;
const TICKS = [1,5,10,20,40,80];
const scaleOf  = gb => Math.min(1, Math.sqrt(Math.min(gb,SCALE_MAX)) / Math.sqrt(SCALE_MAX));
const perGB    = p => (p.data === null || !p.data) ? null : p.price / p.data;
const headroom = p => p.data === null ? Infinity : p.data - state.useData;

/* A plan only appears if it genuinely covers what was asked for. */
function eligible(p){
  if (p.price > state.budget) return false;
  if (p.data !== null && p.data < state.useData) return false;
  if (state.calls === "unlimited" && p.minutes !== "unlimited") return false;
  if (state.type !== "all" && p.type !== state.type) return false;
  if (state.ops.size && !state.ops.has(p.op)) return false;
  return true;
}
function sortPlans(list){
  const c = [...list];
  if (state.sort === "price") c.sort((a,b)=>a.price-b.price);
  if (state.sort === "data")  c.sort((a,b)=>(b.data===null?1e9:b.data)-(a.data===null?1e9:a.data));
  if (state.sort === "pergb") c.sort((a,b)=>{
    const x=perGB(a), y=perGB(b);
    if (x===null && y===null) return a.price-b.price;
    if (x===null) return 1; if (y===null) return -1;
    return x-y;
  });
  if (state.sort === "headroom") c.sort((a,b)=>{
    const x=headroom(a), y=headroom(b);
    return x===y ? a.price-b.price : x-y;
  });
  return c;
}

/* ── The shared measuring axis ────────────────────────────── */
const COLS = "26px 226px 1fr 158px";
function syncAxis(){
  const chart = $("#chart"), overlay = $("#overlay"), axisScale = $("#axisScale");
  const track = document.querySelector(".track");
  if (!track || window.innerWidth <= 900){ overlay.innerHTML = ""; axisScale.innerHTML = ""; return; }

  const cb = chart.getBoundingClientRect(), tb = track.getBoundingClientRect();
  overlay.style.left  = (tb.left - cb.left) + "px";
  overlay.style.width = tb.width + "px";

  const x = scaleOf(state.useData) * 100;
  overlay.innerHTML =
    TICKS.map(g=>`<div class="gline" style="left:${(scaleOf(g)*100).toFixed(3)}%"></div>`).join("") +
    `<div class="needle ${x>70?'flip':''}" style="left:${x.toFixed(3)}%">
       <span class="ntag">${t('yourUse')} · ${state.useData}GB</span></div>`;

  axisScale.innerHTML = TICKS.map(g=>
    `<div class="tick" style="left:${(scaleOf(g)*100).toFixed(3)}%"><span>${g}GB</span></div>`).join("");
}

/* ── Render ───────────────────────────────────────────────── */
function allowanceText(p){
  const bits = [];
  bits.push(p.minutes==="unlimited" ? `<b>∞</b> ${t('mins')}`
        : p.minutes==="bundle" ? `<b>—</b> ${t('mins')}`
        : `<b>${p.minutes}</b> ${t('mins')}`);
  bits.push(p.sms==="unlimited" ? `<b>∞</b> ${t('sms')}`
        : p.sms==="bundle" ? `<b>—</b> ${t('sms')}`
        : `<b>${p.sms}</b> ${t('sms')}`);
  bits.push(esc(p.term));
  if (p.euFup) bits.push(`EU ${p.euFup}GB`);
  let html = bits.map(b=>`<span>${b}</span>`).join("");
  if (p.onnet) html += `<span class="onnet">+ ${esc(p.onnet)}</span>`;
  return html;
}

function render(){
  const list = sortPlans(DB.plans.filter(eligible));
  const cheapest = list.reduce((best,p)=>{
    const v = perGB(p); if (v===null) return best;
    return (best===null || v < perGB(best)) ? p : best;
  }, null);

  $("#count").innerHTML = `<b>${list.length}</b> ${t('of')} ${DB.plans.length} ${t('plansMatch')}`;
  $("#axisLabel").textContent = t('axisLabel');
  $("#axisRight").textContent = t('axisRight');

  if (!list.length){
    $("#results").innerHTML = `<div class="empty"><h3>${t('emptyTitle')}</h3><p>${t('emptyBody')}</p></div>`;
    $("#axis").style.visibility = "hidden";
    $("#overlay").innerHTML = "";
    return;
  }
  $("#axis").style.visibility = "visible";
  const needleX = scaleOf(state.useData) * 100;

  $("#results").innerHTML = list.map((p,i)=>{
    const op   = DB.operators[p.op] || {label:p.op, colour:"#888"};
    const unl  = p.data === null;
    const full = unl ? 100 : scaleOf(p.data) * 100;   // the whole allowance
    const used = Math.min(needleX, full);             // the part you would spend
    const pg   = perGB(p);
    const isOpen = state.open.has(p.id);
    const inside = full > 20;
    const spare  = unl ? null : Math.max(0, p.data - state.useData);
    const label  = unl ? t('unlimited') : (p.data ? p.data + " GB" : t('noData'));

    return `
    <article class="plan mounting ${state.picked.has(p.id)?'picked':''}"
             style="grid-template-columns:${COLS};transition-delay:${Math.min(i*22,340)}ms">
      <div class="pickbox">
        <input type="checkbox" data-pick="${p.id}" ${state.picked.has(p.id)?'checked':''}
               aria-label="Compare ${esc(p.name)}">
      </div>
      <div class="ident">
        ${cheapest && cheapest.id===p.id ? `<span class="tag">${t('best')}</span>` : ``}
        <div class="op"><span class="swatch" style="background:${op.colour}"></span>
          <span class="opname">${esc(op.label)} · ${t(p.type)}</span></div>
        <h3>${esc(p.name)}</h3>
        ${p.el && p.el!==p.name ? `<div class="el">${esc(p.el)}</div>` : ``}
      </div>
      <div class="meter">
        <div class="track">
          <div class="fill-head ${unl?'unl':''}" style="width:${full}%;background:${op.colour}"></div>
          <div class="fill-core" style="width:${used}%;background:${op.colour}"></div>
          <span class="meterlabel ${inside?'inside':'outside'}"
                style="left:${inside?'11px':'calc('+full+'% + 11px)'}">${label}</span>
          <div class="needle-local" style="left:${needleX}%"></div>
        </div>
        <div class="subline">${allowanceText(p)}
          ${spare!==null && spare>0 ? `<span class="spare">${spare.toFixed(spare%1?1:0)}GB ${t('spare')}</span>` : ``}
          <button class="detailbtn" data-toggle="${p.id}" aria-expanded="${isOpen}">${isOpen?t('hide'):t('details')}</button>
        </div>
      </div>
      <div class="price">
        <div><span class="big">${eur(p.price)}</span><span class="per">${t('month')}</span></div>
        <div class="pergb">${pg===null ? '—' : eur(pg) + ' ' + t('perGB')}</div>
        <span class="est ${p.confidence}">${t(p.confidence)}</span>
      </div>
      ${isOpen ? `<div class="detail">
        <div class="prov">${t('src')} — ${esc(p.source||'—')}</div>
        <ul>${(p.notes||[]).map(n=>`<li>${esc(n)}</li>`).join("")}</ul>
        <a href="${esc(p.url)}" target="_blank" rel="noopener">${t('visit')} →</a>
      </div>` : ``}
    </article>`;
  }).join("");

  requestAnimationFrame(()=>requestAnimationFrame(()=>{
    document.querySelectorAll(".plan.mounting").forEach(el=>el.classList.remove("mounting"));
    syncAxis();
  }));
}

function renderTray(){
  const n = state.picked.size;
  $("#tray").classList.toggle("on", n>0);
  $("#trayCount").textContent = n;
  $("#trayNames").textContent = [...state.picked]
    .map(id => (DB.plans.find(p=>p.id===id)||{}).name).filter(Boolean).join("   ·   ");
  $("#openCompare").textContent = t('compare');
  $("#clearPick").textContent = t('clear');
}

function renderCompare(){
  const picks = DB.plans.filter(p=>state.picked.has(p.id));
  if (!picks.length) return;
  const minPrice = Math.min(...picks.map(p=>p.price));
  const pgs = picks.map(perGB).filter(v=>v!==null);
  const minPg = pgs.length ? Math.min(...pgs) : null;
  const maxData = Math.max(...picks.map(p=>p.data===null?1e9:p.data));

  const rows = [
    [t('rowPrice'), p=>`<span class="num">${eur(p.price)}</span>`, p=>p.price===minPrice],
    [t('rowData'),  p=>p.data===null?t('unlimited'):`<span class="num">${p.data} GB</span>`, p=>(p.data===null?1e9:p.data)===maxData],
    [t('rowMins'),  p=>p.minutes==="unlimited"?t('unlimited'):(p.minutes==="bundle"?"—":`<span class="num">${p.minutes}</span>`), ()=>false],
    [t('rowSms'),   p=>p.sms==="unlimited"?t('unlimited'):(p.sms==="bundle"?"—":`<span class="num">${p.sms}</span>`), ()=>false],
    [t('rowOnnet'), p=>p.onnet?esc(p.onnet):"—", ()=>false],
    [t('rowPerGB'), p=>{const v=perGB(p);return v===null?'—':`<span class="num">${eur(v)}</span>`}, p=>minPg!==null&&perGB(p)===minPg],
    [t('rowTerm'),  p=>esc(p.term), ()=>false],
    [t('rowRoam'),  p=>p.euFup?`<span class="num">${p.euFup} GB</span>`:'—', ()=>false],
    [t('rowConf'),  p=>`<span class="est ${p.confidence}">${t(p.confidence)}</span>`, ()=>false]
  ];
  $("#cmpTable").innerHTML =
    `<thead><tr><th></th>${picks.map(p=>{
       const op = DB.operators[p.op]||{};
       return `<th><span class="swatch" style="display:inline-block;margin-right:7px;background:${op.colour}"></span>${esc(p.name)}</th>`;
     }).join("")}</tr></thead>` +
    `<tbody>${rows.map(([label,fn,best])=>
       `<tr><th>${label}</th>${picks.map(p=>`<td class="${best(p)?'best':''}">${fn(p)}</td>`).join("")}</tr>`
     ).join("")}</tbody>`;
  $("#cmpTitle").textContent = t('cmpTitle');
  $("#closeCompare").textContent = t('close');
}

function renderChrome(){
  document.title = t('docTitle');
  document.documentElement.lang = lang;
  $("#wordmark").innerHTML = t('wordmark');
  ["eyebrow","tagline","sizerTitle","sizerLede","lblData","lblCalls","lblBudget","cAny","cUnl",
   "lblSort","aboutTitle","hMethod","hPrices","hCheck","hSources","legal","colophon"]
    .forEach(k => { const el = $("#"+k); if (el) el.textContent = t(k); });
  $("#caveatText").textContent = t('caveat');
  $("#pMethod").textContent = t('pMethod');
  $("#pScope").textContent  = t('pScope');
  $("#pPrices").textContent = t('pPrices');
  $("#checkList").innerHTML = t('checkList').map(x=>`<li>${esc(x)}</li>`).join("");

  const opts = {price:'sortPrice', pergb:'sortPerGB', data:'sortData', headroom:'sortHeadroom'};
  [...$("#sort").options].forEach(o => o.textContent = t(opts[o.value]));

  const contracts = DB.plans.filter(p=>p.type==="contract").length;
  $("#stamp").innerHTML =
    `<b>${DB.plans.length}</b> plans · <b>${Object.keys(DB.operators).length}</b> brands<br>` +
    `<b>${DB.plans.length-contracts}</b> confirmed · <b>${contracts}</b> estimated<br>` +
    `updated <b>${DB.updated}</b>`;

  $("#typeChips").innerHTML = ["all","contract","prepaid"].map(v=>
    `<button class="chip" data-type="${v}" aria-pressed="${state.type===v}">${t(v)}</button>`).join("");
  $("#opChips").innerHTML = Object.entries(DB.operators).map(([k,o])=>
    `<button class="chip" data-op="${k}" aria-pressed="${state.ops.has(k)}">
       <span class="dot" style="background:${o.colour}"></span>${esc(o.label)}</button>`).join("");
}

/* ── Events ───────────────────────────────────────────────── */
document.addEventListener("click", e=>{
  const lb = e.target.closest("[data-lang]");
  if (lb){ lang = lb.dataset.lang;
    document.querySelectorAll("[data-lang]").forEach(b=>b.setAttribute("aria-pressed", b===lb));
    renderChrome(); render(); renderTray(); return; }

  const tc = e.target.closest("[data-type]");
  if (tc){ state.type = tc.dataset.type;
    document.querySelectorAll("[data-type]").forEach(b=>b.setAttribute("aria-pressed", b===tc));
    render(); return; }

  const oc = e.target.closest("[data-op]");
  if (oc){ const k = oc.dataset.op;
    state.ops.has(k) ? state.ops.delete(k) : state.ops.add(k);
    oc.setAttribute("aria-pressed", state.ops.has(k)); render(); return; }

  const cs = e.target.closest("#needCalls [data-v]");
  if (cs){ state.calls = cs.dataset.v;
    document.querySelectorAll("#needCalls [data-v]").forEach(b=>b.setAttribute("aria-pressed", b===cs));
    render(); return; }

  const tg = e.target.closest("[data-toggle]");
  if (tg){ const id = tg.dataset.toggle;
    state.open.has(id) ? state.open.delete(id) : state.open.add(id); render(); return; }

  if (e.target.id === "clearPick"){ state.picked.clear(); render(); renderTray(); return; }
  if (e.target.id === "openCompare"){ renderCompare(); $("#modal").classList.add("on"); $("#closeCompare").focus(); return; }
  if (e.target.id === "closeCompare" || e.target.id === "modal"){ $("#modal").classList.remove("on"); return; }
});

document.addEventListener("change", e=>{
  if (e.target.dataset && e.target.dataset.pick){
    const id = e.target.dataset.pick;
    if (e.target.checked){
      if (state.picked.size >= 4){ e.target.checked = false; return; }
      state.picked.add(id);
    } else state.picked.delete(id);
    e.target.closest(".plan").classList.toggle("picked", e.target.checked);
    renderTray();
    return;
  }
  if (e.target.id === "sort"){ state.sort = e.target.value; render(); }
});

$("#useData").addEventListener("input", e=>{
  state.useData = +e.target.value; $("#useDataOut").textContent = state.useData; render();
});
$("#budget").addEventListener("input", e=>{
  state.budget = +e.target.value; $("#budgetOut").textContent = state.budget; render();
});
document.addEventListener("keydown", e=>{ if (e.key === "Escape") $("#modal").classList.remove("on"); });
let rt; window.addEventListener("resize", ()=>{ clearTimeout(rt); rt = setTimeout(syncAxis, 120); });

renderChrome(); render(); renderTray();
</script>
</body>
</html>
